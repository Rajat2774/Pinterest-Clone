<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Feed | Pinterest</title>
  <!-- Remixicon CDN for icons -->
  <link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet">
  <link rel="stylesheet" href="/stylesheets/feed.css">
</head>
<body>

  <!-- TOP NAVBAR -->
  <nav class="navbar">
    <div class="nav-left">
      <a href="/feed" class="brand-icon" title="Pinterest Home">
        <svg viewBox="0 0 24 24">
          <path d="M12 0a12 12 0 0 0-4.37 23.17c-.07-.63-.13-1.6.03-2.3.14-.6 1.07-4.54 1.07-4.54s-.27-.55-.27-1.37c0-1.28.74-2.24 1.67-2.24.78 0 1.16.59 1.16 1.3 0 .79-.5 1.97-.77 3.07-.22.92.46 1.67 1.37 1.67 1.64 0 2.9-1.73 2.9-4.23 0-2.2-1.58-3.75-3.85-3.75-2.62 0-4.16 1.97-4.16 4 0 .79.3 1.64.68 2.1.08.09.09.17.06.29l-.25 1.04c-.04.17-.14.21-.33.13-1.24-.58-2.02-2.39-2.02-3.85 0-3.13 2.28-6.01 6.57-6.01 3.45 0 6.13 2.46 6.13 5.74 0 3.43-2.16 6.18-5.16 6.18-1.01 0-1.96-.52-2.28-1.14l-.62 2.37c-.23.87-.84 1.96-1.25 2.62A11.96 11.96 0 0 0 12 24c6.63 0 12-5.37 12-12S18.63 0 12 0z"/>
        </svg>
      </a>
      <a href="/feed" class="nav-btn active">Home</a>
      <a href="/feed" class="nav-btn">Explore</a>
      <a href="/profile" class="nav-btn">Create</a>
    </div>

    <div class="nav-center">
      <div class="search-box">
        <i class="ri-search-line"></i>
        <input type="text" placeholder="Search Pins or ideas">
      </div>
    </div>

    <div class="nav-right">
      <button class="icon-btn" title="Notifications">
        <i class="ri-notification-3-line"></i>
      </button>
      <button class="icon-btn" title="Messages">
        <i class="ri-chat-3-line"></i>
      </button>
      <a href="/profile" class="nav-avatar-btn" title="Profile">
        <% if(user && user.dp) { %>
          <img src="/images/uploads/<%= user.dp %>" alt="Profile">
        <% } else { %>
          <%= (user && user.fullname) ? user.fullname.charAt(0).toUpperCase() : 'U' %>
        <% } %>
      </a>
      <a href="/logout" class="icon-btn" title="Logout">
        <i class="ri-logout-box-r-line"></i>
      </a>
    </div>
  </nav>

  <!-- MAIN FEED CONTAINER -->
  <main class="feed-container">
    <% if (posts && posts.length > 0) { %>
      <div class="masonry-grid">
        <% posts.forEach(function(post) { %>
          <div class="feed-card">
            <div class="card-media">
              <img src="/images/uploads/<%= post.image %>" alt="<%= post.postText %>">
              <div class="card-overlay">
                <div class="overlay-top">
                  <span class="creator-badge"><%= post.user ? post.user.username : 'User' %></span>
                  <button class="save-btn">Save</button>
                </div>
              </div>
            </div>
            <div class="card-details">
              <p class="card-title"><%= post.postText %></p>
              <% if (post.user) { %>
                <div class="card-user">
                  <div class="user-avatar">
                    <% if (post.user.dp) { %>
                      <img src="/images/uploads/<%= post.user.dp %>" alt="">
                    <% } else { %>
                      <span><%= post.user.fullname ? post.user.fullname.charAt(0).toUpperCase() : 'U' %></span>
                    <% } %>
                  </div>
                  <span class="user-name"><%= post.user.fullname %></span>
                </div>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty-feed">
        <h2>No pins yet!</h2>
        <p>Upload your first pin from your profile page.</p>
        <a href="/profile" class="btn-pill-primary">Go to Profile</a>
      </div>
    <% } %>
  </main>

</body>
</html>