<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Profile | Pinterest</title>
  <!-- Remixicon CDN for icons -->
  <link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet">
  <link rel="stylesheet" href="/stylesheets/profile.css">
</head>
<body>

  <!-- TOP NAVBAR -->
  <nav class="navbar">
    <div class="nav-left">
      <a href="/feed" class="brand-icon" title="Pinterest Home">
        <svg viewBox="0 0 24 24">
          <path d="M12 0a12 12 0 0 0-4.37 23.17c-.07-.63-.13-1.6.03-2.3.14-.6 1.07-4.54 1.07-4.54s-.27-.55-.27-1.37c0-1.28.74-2.24 1.67-2.24.78 0 1.16.59 1.16 1.3 0 .79-.5 1.97-.77 3.07-.22.92.46 1.67 1.37 1.67 1.64 0 2.9-1.73 2.9-4.23 0-2.2-1.58-3.75-3.85-3.75-2.62 0-4.16 1.97-4.16 4 0 .79.3 1.64.68 2.1.08.09.09.17.06.29l-.25 1.04c-.04.17-.14.21-.33.13-1.24-.58-2.02-2.39-2.02-3.85 0-3.13 2.28-6.01 6.57-6.01 3.45 0 6.13 2.46 6.13 5.74 0 3.43-2.16 6.18-5.16 6.18-1.01 0-1.96-.52-2.28-1.14l-.62 2.37c-.23.87-.84 1.96-1.25 2.62A11.96 11.96 0 0 0 12 24c6.63 0 12-5.37 12-12S18.63 0 12 0z"/>
        </svg>
      </a>
      <a href="/feed" class="nav-btn">Home</a>
      <a href="#" class="nav-btn">Explore</a>
      <a href="#" class="nav-btn">Create</a>
    </div>

    <div class="nav-center">
      <div class="search-box">
        <i class="ri-search-line"></i>
        <input type="text" placeholder="Search your Pins or ideas">
      </div>
    </div>

    <div class="nav-right">
      <button class="icon-btn" title="Notifications">
        <i class="ri-notification-3-line"></i>
      </button>
      <button class="icon-btn" title="Messages">
        <i class="ri-chat-3-line"></i>
      </button>
      <a href="/profile" class="nav-avatar-btn" title="Profile">
        U
      </a>
      <a href="/logout" class="icon-btn" title="Logout">
        <i class="ri-logout-box-r-line"></i>
      </a>
    </div>
  </nav>

  <!-- MAIN PROFILE CONTAINER -->
  <main class="profile-container">

    <!-- HERO PROFILE HEADER -->
    <section class="profile-hero">
      <div class="avatar-wrapper">
        <div class="profile-avatar">
          U
        </div>
        <button class="avatar-edit-badge" title="Change profile picture">
          <i class="ri-camera-fill"></i>
        </button>
      </div>

      <h1 class="profile-name"><%= user.fullname %></h1>
      <p class="profile-username">@<%= user.username %></p>
      
      <div class="profile-stats">
        <span>0 followers</span>
        <span>•</span>
        <span>0 following</span>
        <span>•</span>
        <span>0 pins</span>
      </div>

      <div class="profile-actions">
        <button class="btn-pill btn-pill-secondary">
          <i class="ri-share-forward-line"></i> Share
        </button>
        <button class="btn-pill btn-pill-secondary">
          Edit profile
        </button>
      </div>

      <!-- UPLOAD PIN CARD -->
      <form action="/upload" method="POST" enctype="multipart/form-data" class="upload-pin-card">
        <div class="upload-card-body">
          <div class="upload-input-group">
            <i class="ri-edit-line input-icon"></i>
            <input type="text" name="filecaption" placeholder="Write a caption for your pin..." required>
          </div>
          <div class="upload-file-group">
            <input type="file" name="file" id="pin-file-input" required hidden>
            <label for="pin-file-input" class="upload-file-label">
              <i class="ri-image-add-line"></i>
              <span id="chosen-file-name">Choose image</span>
            </label>
          </div>
          <button type="submit" class="btn-pill btn-pill-primary upload-submit-btn">
            <i class="ri-upload-2-line"></i> Upload
          </button>
        </div>
      </form>
    </section>
  </main>
  <div class="container">
    <div class="cards">
      <% user.posts.forEach(function(post){ %>
        <div class="card">
          <img src="/images/uploads/<%= post.image %>">
          <div class="card-caption">
            <p><%= post.postText %></p>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
  

  <script>
    const fileInput = document.getElementById('pin-file-input');
    const fileNameText = document.getElementById('chosen-file-name');
    if (fileInput) {
      fileInput.addEventListener('change', function() {
        if (this.files && this.files.length > 0) {
          fileNameText.textContent = this.files[0].name;
        } else {
          fileNameText.textContent = 'Choose image';
        }
      });
    }
  </script>
</body>
</html>